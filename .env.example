# Environment variables for AI Chest X-Ray Research Platform
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Streamlit Frontend Configuration
